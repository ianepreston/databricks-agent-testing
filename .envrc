# Local configuration belongs in .env (which is intentionally ignored).
dotenv_if_exists .env

# Keep the project virtual environment synchronized with the committed uv.lock
# whenever direnv enters this directory, then activate it for the shell.
if ! has uv; then
  log_error "uv is required; install it from https://docs.astral.sh/uv/"
  return 1
fi

uv sync --quiet
source .venv/bin/activate
