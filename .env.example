# Copy this file to .env. direnv loads it automatically through .envrc, which
# also syncs and activates the uv-managed .venv. Keep this real configuration
# local: .env is intentionally ignored.
#
# Choose a configured Databricks CLI profile; do not commit a workspace choice.
DATABRICKS_CONFIG_PROFILE=<your-databricks-profile>
BUNDLE_VAR_catalog_storage_root=<catalog-storage-root-url>
