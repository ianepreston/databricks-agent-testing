# Copy this file to .env. direnv loads .env automatically through .envrc.
# Keep the real workspace storage path in .env; it is intentionally ignored.
DATABRICKS_CONFIG_PROFILE=fevm-az-cc
BUNDLE_VAR_catalog_storage_root=<catalog-storage-root-url>

# Optional local-only package proxy. Never set it in the app's bundle config or
# use it when regenerating the committed agent-calendar-v1/uv.lock (must stay
# public PyPI).
# UV_DEFAULT_INDEX=https://pypi-proxy.cloud.databricks.com/simple
